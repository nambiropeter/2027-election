NODE_ENV=production
PORT=3000
POSTGRES_USER=change_this_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=election_poll
REDIS_PASSWORD=change_this_redis_password
DATABASE_URL=postgres://change_this_user:change_this_password@postgres:5432/election_poll
REDIS_URL=redis://:change_this_redis_password@redis:6379
REDIS_TLS=false
DEVICE_SALT=replace-with-64-plus-random-chars
SESSION_SECRET=replace-with-64-plus-random-chars
ALLOWED_ORIGINS=https://poll.example.com
SESSION_COOKIE_NAME=poll_session
SESSION_TTL_HOURS=720
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict
TRUST_PROXY=false
BYPASS_GEO_CHECK=false
ALLOW_LOCALHOST=false
ALLOWED_COUNTRY_CODE=KE
VOTE_PER_IP_PER_MINUTE=20
VOTE_PER_IP_PER_HOUR=200
ANOMALY_BLOCKED_GEO_THRESHOLD_PER_MINUTE=30
ANOMALY_UNIQUE_DEVICES_PER_IP_PER_MINUTE=60
ANOMALY_ALERT_COOLDOWN_SECONDS=300
ALERT_WEBHOOK_URL=
