# ---------------------------------------------------------------------------
# Shared by all three backends: the Node server (src/), the C# service
# (services/KPolls.Api) and the Supabase edge functions.
#
# DEVICE_SALT and SESSION_SECRET must be IDENTICAL across whichever backends you
# run, or voter tokens minted by one will be rejected by the others and people
# will be able to vote again. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
DOMAIN_NAME=kpolls.me

# --- data stores -----------------------------------------------------------
DATABASE_URL=postgresql://postgres.change-this-ref:change_this_password@aws-0-region.pooler.supabase.com:6543/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=postgres

# Redis is optional. The Node server uses it for rate limiting when reachable
# and falls back to the Postgres consume_rate_limit() function when it is not.
REDIS_URL=rediss://default:change_this_token@your-upstash-endpoint.upstash.io:6379
REDIS_PASSWORD=
REDIS_TLS=true

# --- secrets (must be 32+ characters) --------------------------------------
DEVICE_SALT=replace-with-64-plus-random-chars
SESSION_SECRET=replace-with-64-plus-random-chars

# --- vote sessions ---------------------------------------------------------
SESSION_COOKIE_NAME=poll_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict
# How long a voter token stays valid. Should outlast the poll itself, otherwise
# an expired token lets the same person vote a second time.
TOKEN_TTL_HOURS=8760

# --- origins ---------------------------------------------------------------
# Every origin the page is served from. A request whose Origin is absent from
# this list is answered without CORS headers rather than rejected, so a wrong
# entry degrades cross-origin access instead of taking the site down.
ALLOWED_ORIGINS=https://kpolls.me,https://www.kpolls.me
TRUST_PROXY=true

# --- geography -------------------------------------------------------------
ALLOWED_COUNTRY_CODE=KE
# lenient = block only connections positively identified as foreign (default)
# strict  = also block connections whose country cannot be determined. Only use
#           this if you are certain every genuine request carries a country
#           header, otherwise it rejects real voters.
# off     = no geography check (rejected in production)
GEO_ENFORCEMENT=lenient
ALLOW_LOCALHOST=false

# --- abuse controls --------------------------------------------------------
VOTE_PER_IP_PER_MINUTE=10
VOTE_PER_IP_PER_HOUR=60
# Soft cap on votes sharing one network block + browser signature. This is an
# anti-scripting throttle, not an identity check: Kenyan mobile CGNAT puts many
# genuine voters behind one address range, so keep it generous.
MAX_VOTES_PER_FINGERPRINT=25
ANOMALY_ALERT_COOLDOWN_SECONDS=300
ALERT_WEBHOOK_URL=

# --- C# service only -------------------------------------------------------
# Seconds a tally may be served from memory before re-querying.
RESULTS_CACHE_SECONDS=2
DB_MAX_POOL_SIZE=80
