{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 20480,
      "MaxConcurrentConnections": 20000,
      "KeepAliveTimeout": "00:02:00"
    }
  },
  "Poll": {
    "AllowedCountryCode": "KE",
    "GeoEnforcement": "lenient",
    "TrustProxy": true,
    "TokenTtlHours": 8760,
    "VotePerIpPerMinute": 10,
    "VotePerIpPerHour": 60,
    "MaxVotesPerFingerprint": 25,
    "ResultsCacheSeconds": 2,
    "MaxPoolSize": 80
  }
}
